node_modules/
output/
logs/
auth.json
# A repo-local .npmrc is a normal thing to create (npm config set, or working
# around NODE_AUTH_TOKEN) and routinely holds a registry auth token. This repo
# already ignores auth.json for exactly that reason; without this line the token
# would show up in `git status` looking like a file to commit. Nothing reads a
# repo-local .npmrc, so ignoring it costs nothing.
.npmrc
*.log
.DS_Store
diag-dumps/
# Raw dump captures are never committed (they contain authenticated DOM and PII).
# Only the hand-written catalogue for each capture session is kept. The dance below
# is deliberate: ignore the session dirs, re-include them so git descends, ignore
# their contents, then re-include just INDEX.md. Using `dumps/` outright would stop
# git descending and make the final negation unreachable.
dumps/*
!dumps/*/
dumps/*/*
!dumps/*/INDEX.md
.qwen
QWEN.md
.opencode/

{
  "name": "@msout/microsoft-onenote-export-notebook",
  "version": "0.3.6",
  "description": "Export Microsoft OneNote notebook to Obsidian Markdown via Playwright — extracted from MSOneNote Exporter",
  "main": "src/exporter.js",
  "exports": {
    ".": "./src/exporter.js",
    "./cli": "./src/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ms-OneNote-Exporter/microsoft-onenote-export-notebook.git"
  },
  "homepage": "https://github.com/Ms-OneNote-Exporter/microsoft-onenote-export-notebook#readme",
  "bugs": {
    "url": "https://github.com/Ms-OneNote-Exporter/microsoft-onenote-export-notebook/issues"
  },
  "files": [
    "src/",
    "CHANGELOG.md",
    "NOTICE.md"
  ],
  "bin": {
    "onenote-export-nb": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "export": "node src/index.js export",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint ."
  },
  "keywords": [
    "microsoft",
    "onenote",
    "playwright",
    "export",
    "obsidian",
    "markdown",
    "webauth"
  ],
  "author": "msout@tuta.io",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.3.3",
    "playwright": "^1.63.0",
    "sanitize-filename": "^1.6.3",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "jest": "^29.7.0"
  }
}
